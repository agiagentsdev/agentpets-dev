# AgentPets environment variables.
#
# Local paths:
# - bun run dev:mock   -> zero real credentials, uses .env.mock
# - bun run dev:docker -> local Postgres/Redis with shared dev defaults
# - bun run dev        -> your own .env.local values
#
# Production deploy:
# Set the "required for launch" values in Vercel or Cloudflare. Keep this
# file committed as documentation only; never commit .env.local.

# Required for launch: database
DATABASE_URL=

# Required for launch: Clerk web auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required for launch: CLI OAuth config served from /api/cli/auth-config
AGENTPETS_CLERK_CLI_ISSUER=https://clerk.agentpets.dev
AGENTPETS_CLERK_CLI_CLIENT_ID=
AGENTPETS_CLERK_CLI_SCOPES=openid profile email
CLERK_CLI_ISSUER=https://clerk.agentpets.dev
CLERK_CLI_CLIENT_ID=
CLERK_CLI_SCOPES=openid profile email

# Required for launch: Redis cache/rate limits/telemetry ingest
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TELEMETRY_RATELIMIT_SECRET=

# Required for launch if submit/edit/upload flows are enabled: Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agentpets-pets
R2_PUBLIC_BASE=https://assets.agentpets.dev

# Canonical app URLs
AGENTPETS_URL=https://agentpets.dev
# Legacy alias kept for Petdex-compatible scripts and older CLI builds.
PETDEX_URL=https://agentpets.dev
VERCEL_URL=

# Admin users
AGENTPETS_ADMIN_USER_IDS=
NEXT_PUBLIC_AGENTPETS_ADMIN_USER_IDS=
# Legacy aliases. Keep these in sync until every old script is migrated.
PETDEX_ADMIN_USER_IDS=
NEXT_PUBLIC_PETDEX_ADMIN_USER_IDS=
HENRY_USER_ID=
NEXT_PUBLIC_HENRY_USER_ID=

# Email notifications
RESEND_API_KEY=
RESEND_FROM=AgentPets <hello@agentpets.dev>
RESEND_WEBHOOK_SECRET=
AGENTPETS_OWNER_EMAIL=hello@agentpets.dev
AGENTPETS_ADMIN_NOTIFY_EMAIL=hello@agentpets.dev
PETDEX_OWNER_EMAIL=hello@agentpets.dev
PETDEX_ADMIN_NOTIFY_EMAIL=hello@agentpets.dev

# Community CTAs
NEXT_PUBLIC_DISCORD_INVITE_URL=
NEXT_PUBLIC_WECHAT_COMMUNITY_ENABLED=

# Optional: Aliyun OSS credentials for zh WeChat QR serving
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=

# Optional: ads checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: AI review, tagging, image/audio helpers
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
ELEVENLABS_API_KEY=
FFMPEG_BIN=

# Optional: desktop/CLI supporting assets and telemetry
PETDEX_ALL_PETS_PACK_URL=
AGENTPETS_TELEMETRY_URL=https://agentpets.dev/api/telemetry/event
PETDEX_TELEMETRY_URL=https://agentpets.dev/api/telemetry/event
PETDEX_TELEMETRY=1
AGENTPETS_HEALTH_TOKEN=
HEALTHCHECK_TOKEN=

# Optional: development and maintenance switches
PETDEX_MOCK=
PETDEX_MOCK_AUTH=
PETDEX_DISABLE_NEXT_CACHE=
PETDEX_REVIEW_DB=

# Optional: legacy Clerk scripts
CLERK_ISSUER=
CLERK_OAUTH_CLIENT_ID=
PETDEX_CLERK_APP=
PETDEX_CLERK_INSTANCE=production

# Optional: Discord bot package
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
AGENTPETS_WEBHOOK_SECRET=
PETDEX_WEBHOOK_SECRET=
AGENTPETS_API_BASE=https://agentpets.dev
PETDEX_API_BASE=https://agentpets.dev
